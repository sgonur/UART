# iCEBreaker v1.x (iCE40UP5K-SG48), 12 MHz oscillator
# Pins: https://github.com/icebreaker-fpga/icebreaker

set_io -nowarn clk      35
set_io -nowarn uart_rx   6   # FTDI TX -> FPGA RX
set_io -nowarn uart_tx   9   # FPGA TX -> FTDI RX
set_io -nowarn led_n    11   # LEDR_N (red, active low)

# LEDs on the PMOD 2 snap-off board (active high), used as debug indicators
set_io -nowarn led_o[1] 26   # L1: heartbeat
set_io -nowarn led_o[2] 27   # L2: RX line activity
set_io -nowarn led_o[3] 25   # L3: byte received
set_io -nowarn led_o[4] 23   # L4: TX sending
set_io -nowarn led_o[5] 21   # L5: parity error seen
